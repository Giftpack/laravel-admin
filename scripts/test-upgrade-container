#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
engine=${1:-pgsql}
case "$engine" in pgsql) host=postgres;port=5432;;mysql)host=mysql;port=3306;;*)exit 2;;esac
project="laravel-admin-upgrade-$(date +%s)-$$"
export TEST_DB_CONNECTION="$engine" TEST_DB_HOST="$host" TEST_DB_PORT="$port"
export TEST_RESULTS_DIR="$(pwd)/.scratch/php85-laravel13-upgrade/artifacts"
fixture="$TEST_RESULTS_DIR/issue20-rehearsal-$engine-$(date +%s)-$$"
mkdir -p "$fixture"
baseline="$(pwd)/.scratch/php85-laravel13-upgrade/issue10-baseline-root"
vendor="$(pwd)/.scratch/php85-laravel13-upgrade/baseline-vendor"
[ -f "$baseline/src/Admin.php" ] && [ -f "$vendor/autoload.php" ]
cleanup(){ docker compose --env-file /dev/null -p "$project" down --volumes --remove-orphans >/dev/null; }
trap cleanup EXIT
trap 'exit 130' HUP INT TERM
docker compose --env-file /dev/null -p "$project" up -d --wait "$host"
run(){ image=$1;shift;docker compose --env-file /dev/null -p "$project" run --rm --no-deps --entrypoint php -v "$fixture:/rehearsal" -v "$baseline:/baseline:ro" -v "$vendor:/baseline/vendor:ro" application "$@"; }
# An override changes only the runtime image, keeping the same project/database/host bind.
printf 'services:\n  application:\n    image: laravel-admin-php84-baseline:issue20\n' > "$fixture/php84.yml"
old(){ docker compose -f docker-compose.yml -f "$fixture/php84.yml" --env-file /dev/null -p "$project" run --rm --no-deps -v "$fixture:/rehearsal" -v "$baseline:/baseline:ro" -v "$vendor:/baseline/vendor:ro" application php "$@"; }
new(){ run current "$@"; }
old /application/scripts/rehearse-upgrade.php initialize
old /application/scripts/rehearse-upgrade.php verify baseline-uncached
old /rehearsal/app/artisan config:cache
old /rehearsal/app/artisan route:cache
old /application/scripts/rehearse-upgrade.php verify baseline-cached
cp "$fixture/active-cookies.json" "$fixture/transition-cookies.json"
old /application/scripts/rehearse-upgrade.php snapshot before > "$fixture/before.log"
old /application/scripts/rehearse-upgrade.php export > "$fixture/baseline.csv"
old -r 'chdir("/rehearsal/app");passthru("composer check-platform-reqs --format=json",$status);exit($status);' > "$fixture/baseline-platform.json"
# Full native DB backup, and code/config/published/upload/session backup of this installation.
if [ "$engine" = pgsql ];then
 docker compose --env-file /dev/null -p "$project" exec -T postgres pg_dump -U laravel_admin_test -d laravel_admin_test --clean --if-exists --no-owner --no-privileges > "$fixture/database.sql"
else
 docker compose --env-file /dev/null -p "$project" exec -T mysql sh -c 'MYSQL_PWD="$MYSQL_PASSWORD" mysqldump -ularavel_admin_test --no-tablespaces laravel_admin_test' > "$fixture/database.sql"
fi
tar -cf "$fixture/application-backup.tar" -C "$fixture" app
# Clear framework caches using the old runtime BEFORE code/runtime replacement.
old /rehearsal/app/artisan optimize:clear
rm "$fixture/app/vendor"
cp .scratch/php85-laravel13-upgrade/dependencies/host-current/composer.json "$fixture/app/composer.json"
cp .scratch/php85-laravel13-upgrade/dependencies/host-current/composer.lock "$fixture/app/composer.lock"
docker compose --env-file /dev/null -p "$project" run --rm --no-deps -v "$fixture:/rehearsal" -w /rehearsal/app application composer install --no-interaction --no-progress > "$fixture/upgrade-composer.log" 2>&1
new /application/scripts/publish-upgrade-assets.php
new /application/scripts/merge-upgrade-header.php
# Explicit operator session/cache policy: fresh authentication after each code transition.
new -r 'foreach(glob("/rehearsal/app/storage/framework/sessions/*") as $p)unlink($p);'
new /application/scripts/rehearse-upgrade.php snapshot upgraded-before-behavior > "$fixture/upgraded-before-behavior.log"
new /application/scripts/rehearse-upgrade.php stale-session
new /application/scripts/rehearse-upgrade.php verify upgraded-uncached
new /rehearsal/app/artisan config:cache
new /rehearsal/app/artisan route:cache
new /application/scripts/rehearse-upgrade.php verify upgraded-cached
new /application/scripts/rehearse-upgrade.php export > "$fixture/upgraded.csv"
new /application/scripts/rehearse-upgrade.php snapshot after > "$fixture/after.log"
# Rehearse actual restoration into the SAME app path and SAME database.
new -r 'require "/rehearsal/app/vendor/autoload.php";(new Illuminate\Filesystem\Filesystem())->deleteDirectory("/rehearsal/app");'
tar -xf "$fixture/application-backup.tar" -C "$fixture"
if [ "$engine" = pgsql ];then
 docker compose --env-file /dev/null -p "$project" exec -T postgres psql -v ON_ERROR_STOP=1 -U laravel_admin_test -d laravel_admin_test < "$fixture/database.sql" > "$fixture/restore.log"
else
 docker compose --env-file /dev/null -p "$project" exec -T mysql sh -c 'MYSQL_PWD="$MYSQL_PASSWORD" mysql -ularavel_admin_test laravel_admin_test' < "$fixture/database.sql" > "$fixture/restore.log"
fi
old /application/scripts/rehearse-upgrade.php snapshot restored > "$fixture/restored.log"
old /rehearsal/app/artisan optimize:clear
old -r 'foreach(glob("/rehearsal/app/storage/framework/sessions/*") as $p)unlink($p);'
old /application/scripts/rehearse-upgrade.php stale-session
old /application/scripts/rehearse-upgrade.php verify rollback-uncached
old /rehearsal/app/artisan config:cache
old /rehearsal/app/artisan route:cache
old /application/scripts/rehearse-upgrade.php verify rollback-cached
old /application/scripts/rehearse-upgrade.php export > "$fixture/rollback.csv"
python3 scripts/compare-upgrade-rehearsal.py "$fixture"
echo "Rehearsal evidence: $fixture"
