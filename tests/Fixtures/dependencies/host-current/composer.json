    "repositories": [
        {
            "type": "path",
            "url": "/application",
            "options": {
                "symlink": true,
                "versions": {
                    "encore/laravel-admin": "2.0.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Models\\": "/application/tests/models/",
            "Tests\\Controllers\\": "/application/tests/controllers/"
        },
        "classmap": [
            "/application/tests/TestCase.php"
        ]
    }
